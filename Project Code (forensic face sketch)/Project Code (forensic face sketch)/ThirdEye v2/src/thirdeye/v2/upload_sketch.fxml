<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>

<AnchorPane id="AnchorPane" prefHeight="620.0" prefWidth="1000.0" style="-fx-background-color: #1a1a2e;"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="thirdeye.v2.Upload_sketchController">
    <stylesheets>
        <URL value="@upload_sketch.css"/>
    </stylesheets>
    <children>
        <!-- Title Bar -->
        <Label layoutX="0" layoutY="15" prefWidth="1000"
               text="⚖  ThirdEye — Forensic Face Comparison"
               style="-fx-text-fill: #e0e0ff; -fx-alignment: CENTER; -fx-font-size: 22px; -fx-font-weight: bold;"/>
        <HBox layoutX="20" layoutY="15" spacing="20" alignment="CENTER_LEFT">
            <Button text="⬅ Back" onAction="#onBack"
                    style="-fx-background-color: transparent; -fx-text-fill: #aabbff; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;"/>
        </HBox>

        <!-- LEFT: Sketch Panel -->
        <VBox layoutX="60" layoutY="90" spacing="10" alignment="CENTER">
            <Label text="COMPOSITE SKETCH" style="-fx-text-fill: #a0a0cc; -fx-font-size: 13px; -fx-font-weight: bold;"/>
            <AnchorPane fx:id="sketchBox" prefWidth="380" prefHeight="380" onMouseClicked="#onLoadSketch"
                        style="-fx-background-color: #16213e; -fx-border-color: #4444aa; -fx-border-width: 2; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand;">
                <ImageView fx:id="sketchView" fitWidth="380" fitHeight="380" preserveRatio="true"
                           AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0"/>
            </AnchorPane>
            <Button text="📁  UPLOAD SKETCH IMAGE" onAction="#onLoadSketch" prefWidth="240" prefHeight="36"
                    style="-fx-background-color: #2a2a4e; -fx-text-fill: #aabbff; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"/>
            <Label fx:id="sketchLabel" text="Click above or click image box to browse a sketch image"
                   style="-fx-text-fill: #8888aa; -fx-font-size: 11px;"/>
        </VBox>

        <!-- CENTER: Compare Panel -->
        <VBox layoutX="560" layoutY="180" spacing="22" alignment="CENTER" prefWidth="330">
            <Label text="FIND MATCHES" style="-fx-text-fill: #a0a0cc; -fx-font-size: 15px; -fx-font-weight: bold;"/>
            <Label text="Compare the sketch against a\nfolder of suspect photos." wrapText="true"
                   style="-fx-text-fill: #888899; -fx-font-size: 13px; -fx-alignment: CENTER; -fx-text-alignment: CENTER;"/>
            <Button fx:id="compareBtn" text="▶  COMPARE" onAction="#onCompare"
                    prefWidth="200" prefHeight="52"
                    style="-fx-background-color: #3344cc; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"/>
            <Label fx:id="statusBar" text="Load a sketch, then click COMPARE"
                   wrapText="true" prefWidth="310"
                   style="-fx-text-fill: #888899; -fx-font-size: 11px; -fx-alignment: CENTER; -fx-text-alignment: CENTER;"/>
        </VBox>

        <!-- Bottom status bar -->
        <Label layoutX="0" layoutY="580" prefWidth="1000"
               text="ThirdEye v2 — Forensic sketch matching against a photo dataset"
               style="-fx-text-fill: #555577; -fx-font-size: 11px; -fx-alignment: CENTER; -fx-background-color: #0f0f1e; -fx-padding: 6;"/>
    </children>
</AnchorPane>