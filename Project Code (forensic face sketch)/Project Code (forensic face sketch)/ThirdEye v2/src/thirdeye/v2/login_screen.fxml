<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane id="AnchorPane" fx:id="login_page"
            prefHeight="800.0" prefWidth="1200.0"
            style="-fx-background-color: #080c18;"
            xmlns="http://javafx.com/javafx/11.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="thirdeye.v2.Login_screenController">
   <stylesheets>
      <URL value="@login_screen.css" />
   </stylesheets>
   <children>

      <!-- ═══════════════════════════════════════════════════════════ -->
      <!--  LEFT PANEL — Branding                                      -->
      <!-- ═══════════════════════════════════════════════════════════ -->
      <AnchorPane prefWidth="520.0" AnchorPane.topAnchor="0.0" AnchorPane.leftAnchor="0.0"
                  AnchorPane.bottomAnchor="0.0"
                  style="-fx-background-color: linear-gradient(to bottom, #0f1535, #0a0e28, #060a1a);">
         <children>

            <!-- Accent left bar -->
            <Rectangle width="4.0" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                       AnchorPane.leftAnchor="0.0"
                       fill="linear-gradient(to bottom, #00d4ff, #7b2ff7, #00d4ff)"/>

            <!-- Logo -->
            <ImageView fitHeight="90.0" fitWidth="340.0" layoutX="90.0" layoutY="280.0"
                       pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@Transparent%20Logo.png" />
               </image>
            </ImageView>

            <!-- System title -->
            <Text fill="#a0bce0" layoutX="90.0" layoutY="400.0"
                  text="Forensic Intelligence System" strokeType="OUTSIDE" strokeWidth="0.0">
               <font><Font name="Century Gothic" size="17.0"/></font>
            </Text>

            <!-- Divider -->
            <Rectangle width="340.0" height="1.5" layoutX="90.0" layoutY="425.0"
                       fill="linear-gradient(to right, transparent, #3a4fff80, transparent)"/>

            <!-- Feature bullets -->
            <Text fill="#5a6a90" layoutX="90.0" layoutY="462.0"
                  text="▸  Forensic face sketch composer" strokeType="OUTSIDE" strokeWidth="0.0">
               <font><Font name="Century Gothic" size="13.0"/></font>
            </Text>
            <Text fill="#5a6a90" layoutX="90.0" layoutY="490.0"
                  text="▸  AI-powered suspect comparison" strokeType="OUTSIDE" strokeWidth="0.0">
               <font><Font name="Century Gothic" size="13.0"/></font>
            </Text>
            <Text fill="#5a6a90" layoutX="90.0" layoutY="518.0"
                  text="▸  Secure authenticated access" strokeType="OUTSIDE" strokeWidth="0.0">
               <font><Font name="Century Gothic" size="13.0"/></font>
            </Text>
            <Text fill="#5a6a90" layoutX="90.0" layoutY="546.0"
                  text="▸  Forensic report generation" strokeType="OUTSIDE" strokeWidth="0.0">
               <font><Font name="Century Gothic" size="13.0"/></font>
            </Text>

            <!-- Version badge -->
            <Text fill="#2a3a60" layoutX="90.0" layoutY="700.0"
                  text="v2.0  ·  Authorised Personnel Only" strokeType="OUTSIDE" strokeWidth="0.0">
               <font><Font name="Century Gothic" size="11.0"/></font>
            </Text>

         </children>
      </AnchorPane>

      <!-- ═══════════════════════════════════════════════════════════ -->
      <!--  RIGHT PANEL — Login Form                                   -->
      <!-- ═══════════════════════════════════════════════════════════ -->
      <AnchorPane AnchorPane.topAnchor="0.0" AnchorPane.leftAnchor="520.0"
                  AnchorPane.rightAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                  style="-fx-background-color: #0b0f20;">
         <children>

            <!-- LOGIN heading -->
            <Label layoutX="80.0" layoutY="180.0" text="LOGIN" textFill="#e8eeff">
               <font><Font name="Arial Bold" size="42.0"/></font>
            </Label>

            <!-- Subtitle -->
            <Text fill="#5a6a90" layoutX="82.0" layoutY="248.0" strokeType="OUTSIDE" strokeWidth="0.0"
                  text="Enter your authorised credentials to access the system.">
               <font><Font name="Century Gothic" size="13.0"/></font>
            </Text>

            <!-- Email field -->
            <TextField fx:id="email" layoutX="80.0" layoutY="280.0"
                       prefHeight="52.0" prefWidth="440.0"
                       promptText="Registered Email"
                       styleClass="te-field">
               <font><Font name="Century Gothic" size="16.0"/></font>
            </TextField>

            <!-- Password field (PasswordField — hides text) -->
            <PasswordField fx:id="password" layoutX="80.0" layoutY="355.0"
                           prefHeight="52.0" prefWidth="440.0"
                           promptText="Password"
                           styleClass="te-field">
               <font><Font name="Century Gothic" size="16.0"/></font>
            </PasswordField>

            <!-- OTP field (hidden by default) -->
            <TextField fx:id="otp" layoutX="80.0" layoutY="430.0"
                       prefHeight="52.0" prefWidth="440.0"
                       promptText="One-Time Password"
                       visible="false" styleClass="te-field">
               <font><Font name="Century Gothic" size="16.0"/></font>
            </TextField>

            <!-- Status / error message -->
            <Text fx:id="error" fill="#ff6b6b" layoutX="82.0" layoutY="510.0"
                  strokeType="OUTSIDE" strokeWidth="0.0" wrappingWidth="440.0">
               <font><Font name="Century Gothic" size="13.0"/></font>
            </Text>

            <!-- SIGN IN button -->
            <Button fx:id="send" layoutX="80.0" layoutY="540.0"
                    prefHeight="52.0" prefWidth="200.0"
                    text="SIGN IN" mnemonicParsing="false"
                    onAction="#handleButtonAction"
                    styleClass="te-btn-primary">
               <font><Font name="Arial Bold" size="15.0"/></font>
            </Button>

            <!-- SIGN UP button -->
            <Button fx:id="signup" layoutX="300.0" layoutY="540.0"
                    prefHeight="52.0" prefWidth="220.0"
                    text="CREATE ACCOUNT" mnemonicParsing="false"
                    onAction="#handleButtonAction"
                    styleClass="te-btn-secondary">
               <font><Font name="Arial Bold" size="13.0"/></font>
            </Button>

            <!-- VERIFY OTP button (hidden by default) -->
            <Button fx:id="verify" layoutX="80.0" layoutY="540.0"
                    prefHeight="52.0" prefWidth="200.0"
                    text="VERIFY OTP" mnemonicParsing="false"
                    onAction="#handleButtonAction"
                    visible="false" styleClass="te-btn-primary">
               <font><Font name="Arial Bold" size="15.0"/></font>
            </Button>

            <!-- Hidden OTP storage fields -->
            <Text fx:id="hide"  fill="#0b0f20" layoutX="0.0" layoutY="0.0" text="otp"  visible="false"/>
            <Text fx:id="hide1" fill="#0b0f20" layoutX="0.0" layoutY="5.0" text="otp"  visible="false"/>
            <Text fx:id="loginmsg"   fill="#0b0f20" layoutX="0.0" layoutY="10.0" text="successful" visible="false"/>
            <Text fx:id="loginerror" fill="#0b0f20" layoutX="0.0" layoutY="15.0" visible="false"/>

            <!-- Bottom bar -->
            <Rectangle AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
                       AnchorPane.bottomAnchor="0.0" height="40.0"
                       fill="#060a18"/>
            <Text fill="#2a3a60"
                  AnchorPane.bottomAnchor="12.0" AnchorPane.leftAnchor="80.0"
                  text="ThirdEye Forensic System  ·  Authorised Access Only"
                  strokeType="OUTSIDE" strokeWidth="0.0">
               <font><Font name="Century Gothic" size="11.0"/></font>
            </Text>

         </children>
      </AnchorPane>

   </children>
</AnchorPane>
