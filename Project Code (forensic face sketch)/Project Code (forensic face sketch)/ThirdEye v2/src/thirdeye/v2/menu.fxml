<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane id="AnchorPane" prefHeight="800.0" prefWidth="1200.0"
            style="-fx-background-color: #080c18;"
            xmlns="http://javafx.com/javafx/11.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="thirdeye.v2.MenuController">
   <stylesheets>
      <URL value="@menu.css" />
   </stylesheets>
   <children>

      <!-- Top accent bar -->
      <Rectangle AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
                 AnchorPane.topAnchor="0.0" height="3.0"
                 fill="linear-gradient(to right, #3a6fff, #7b2ff7, #00d4ff)"/>

      <!-- Centered Header Block (Logo, Subtitle, Separator) -->
      <VBox alignment="CENTER" spacing="12.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="60.0">
         <children>
            <ImageView fitHeight="90.0" fitWidth="400.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@Transparent%20Logo.png" />
               </image>
            </ImageView>
            <Text fill="#5a6a90" strokeType="OUTSIDE" strokeWidth="0.0" text="Select a workflow to proceed">
               <font><Font name="Century Gothic" size="15.0"/></font>
            </Text>
            <Rectangle width="400.0" height="1.5" fill="linear-gradient(to right, transparent, #2a3a7a, transparent)"/>
         </children>
      </VBox>

      <!-- Centered Cards Area -->
      <HBox alignment="CENTER" spacing="80.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="260.0">
         <children>
            <!-- Card 1: Create Sketch -->
            <VBox fx:id="sketch" alignment="TOP_CENTER" spacing="15.0" prefWidth="320.0" prefHeight="310.0"
                  onMousePressed="#sketch" styleClass="menu-card">
               <children>
                  <ImageView fitHeight="90.0" fitWidth="90.0" pickOnBounds="true" preserveRatio="true">
                     <image><Image url="@drawing.png"/></image>
                  </ImageView>
                  <Label text="Create Sketch" textFill="#d0deff" alignment="CENTER" textAlignment="CENTER" style="-fx-font-weight: bold; -fx-font-size: 20px; -fx-font-family: 'Arial';">
                  </Label>
                  <Text fill="#5a6a90" textAlignment="CENTER" strokeType="OUTSIDE" strokeWidth="0.0"
                        text="Build a forensic composite sketch from facial elements."
                        wrappingWidth="280.0">
                     <font><Font name="Century Gothic" size="13.0"/></font>
                  </Text>
               </children>
            </VBox>

            <!-- Card 2: Upload & Compare -->
            <VBox fx:id="upload" alignment="TOP_CENTER" spacing="15.0" prefWidth="320.0" prefHeight="310.0"
                  onMousePressed="#upload" styleClass="menu-card">
               <children>
                  <ImageView fitHeight="90.0" fitWidth="90.0" pickOnBounds="true" preserveRatio="true">
                     <image><Image url="@upload.png"/></image>
                  </ImageView>
                  <Label text="Upload &amp; Compare" textFill="#d0deff" alignment="CENTER" textAlignment="CENTER" style="-fx-font-weight: bold; -fx-font-size: 20px; -fx-font-family: 'Arial';">
                  </Label>
                  <Text fill="#5a6a90" textAlignment="CENTER" strokeType="OUTSIDE" strokeWidth="0.0"
                        text="Upload a sketch and match against a suspect photograph."
                        wrappingWidth="280.0">
                     <font><Font name="Century Gothic" size="13.0"/></font>
                  </Text>
               </children>
            </VBox>
         </children>
      </HBox>

      <!-- Bottom bar — neutral professional footer -->
      <Rectangle AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
                 AnchorPane.bottomAnchor="0.0" height="36.0"
                 fill="#060a14"/>
      <Text fill="#1e2a48"
            AnchorPane.bottomAnchor="12.0" AnchorPane.leftAnchor="0.0"
            AnchorPane.rightAnchor="0.0"
            text="ThirdEye Forensic Intelligence System  ·  Authorised Personnel Only"
            textAlignment="CENTER"
            strokeType="OUTSIDE" strokeWidth="0.0">
         <font><Font name="Century Gothic" size="11.0"/></font>
      </Text>

   </children>
</AnchorPane>
