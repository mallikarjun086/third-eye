<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.control.Label?>
<?import java.net.URL?>

<AnchorPane fx:id="splash"
            prefHeight="600.0" prefWidth="1024.0"
            style="-fx-background-color: linear-gradient(to bottom right, #0a0a1a, #0f1535, #0a0a1a);"
            xmlns="http://javafx.com/javafx/11.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="thirdeye.v2.splash_screenController">
   <children>

      <!-- Background decorative accent bars -->
      <Rectangle width="4.0" height="600.0" layoutX="0.0" layoutY="0.0"
                 fill="linear-gradient(to bottom, #00d4ff, #7b2ff7)"/>
      <Rectangle width="4.0" height="600.0" layoutX="1020.0" layoutY="0.0"
                 fill="linear-gradient(to bottom, #7b2ff7, #00d4ff)"/>

      <!-- Logo -->
      <ImageView fitHeight="110.0" fitWidth="420.0" layoutX="302.0" layoutY="200.0"
                 pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@Transparent%20Logo.png" />
         </image>
      </ImageView>

      <!-- Tagline -->
      <Text fill="#a0b4e0" layoutX="280.0" layoutY="345.0" strokeType="OUTSIDE" strokeWidth="0.0"
            text="Forensic Intelligence System  ·  v2.0"
            textAlignment="CENTER" wrappingWidth="470.0">
         <font>
            <Font name="Century Gothic" size="16.0" />
         </font>
      </Text>

      <!-- Loading indicator text -->
      <Text fill="#4a5a80" layoutX="420.0" layoutY="510.0" strokeType="OUTSIDE" strokeWidth="0.0"
            text="Initialising secure environment…" textAlignment="CENTER" wrappingWidth="200.0">
         <font>
            <Font name="Century Gothic" size="11.0" />
         </font>
      </Text>

      <!-- Thin bottom accent line -->
      <Rectangle width="300.0" height="2.0" layoutX="362.0" layoutY="370.0"
                 fill="linear-gradient(to right, transparent, #3a4fff, transparent)"/>

   </children>
</AnchorPane>
